{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#shared/*": ["./shared/*"],
      "~~/*": ["./*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "electron/**/*.ts", "server/**/*.ts", "mcpb/**/*.ts"]
}
