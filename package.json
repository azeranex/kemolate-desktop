{
  "name": "kemolate-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "Kemolate as a desktop app: Electron, one machine, local data.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && pnpm build:mcpb",
    "build:mcpb": "vite build --config mcpb/vite.config.ts",
    "preview": "electron .",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@huggingface/transformers": "4.2.0",
    "@lucide/vue": "^1.59.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-updater": "6.8.10",
    "hyphen": "1.14.1",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@nuxt/eslint-config": "1.16.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "@webgpu/types": "^0.1.74",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
