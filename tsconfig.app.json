{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./app/*"],
      "~/*": ["./app/*"],
      "#shared/*": ["./shared/*"],
      "~~/*": ["./*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.vue", "shared/**/*.ts", "electron/preload.ts"]
}
